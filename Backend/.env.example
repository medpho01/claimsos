# ─────────────────────────────────────────────────────────────────────────────
# ClaimOS Backend — environment contract
#
# Copy to Backend/.env and fill in. Every variable here is annotated with who
# requires it, so this file and Backend/src/Utils/env.util.ts agree line for
# line. Validate before deploying:
#
#     npm run check-env:api        # the `backend` service
#     npm run check-env:worker     # the `worker` service (strict superset)
#
# VALUES MUST HAVE NO LEADING/TRAILING WHITESPACE — boot validation rejects
# them. `docker run --env-file` rejects such values outright while Compose
# silently tolerates them, which is exactly how they got into a live .env.
#
# Editing this file requires `docker compose up -d --force-recreate`.
# `docker compose restart` does NOT re-read env_file.
#
# Roles: RUN_WORKERS=false => "api" role. Anything else (INCLUDING UNSET)
# => "worker" role, which additionally requires Redis + Anthropic + AWS creds.
# ─────────────────────────────────────────────────────────────────────────────


# ── App / server ─────────────────────────────────────────────────────────────
NODE_ENV=development                    # OPTIONAL — default: development (development|production|test, any case)
PORT=8000                               # OPTIONAL — default: 8000
RUN_WORKERS=false                       # OPTIONAL — default: unset = workers RUN. "false" => API-only
CORS_ORIGIN=http://localhost:5001       # OPTIONAL — default: none (CORS then falls back to the app default)
APP_BASE_URL=http://localhost:5001      # OPTIONAL — canonical public URL. Legacy alias: FRONTEND_URL
METRICS_TOKEN=                          # OPTIONAL — unset => /metrics returns 503. REQUIRED in practice for Prometheus
LOG_LEVEL=info                          # OPTIONAL — default: info
APP_VERSION=dev                         # OPTIONAL — surfaced on /health


# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost                 # REQUIRED (api, worker)
POSTGRES_PORT=5432                      # REQUIRED (api, worker)
POSTGRES_USER=postgres                  # REQUIRED (api, worker)
POSTGRES_PASSWORD=change-me             # REQUIRED (api, worker)
POSTGRES_DB=claimsos                    # REQUIRED (api, worker)
POSTGRES_SSLMODE=                       # OPTIONAL — default: "" for local hosts, "no-verify" for everything else (RDS)
DB_SSL=false                            # OPTIONAL — default: false. Must be the LITERAL string "true" to enable
# DATABASE_URL=                         # OPTIONAL — overrides the five vars above for the migration/seed runners only


# ── Redis ────────────────────────────────────────────────────────────────────
# THE SINGLE MOST COMMON DEPLOY FAILURE. 20 worker files default this to
# redis://localhost:6379, which inside a container resolves to the container's
# OWN loopback — the queue then silently never drains and nothing logs an error.
# In Compose it MUST be redis://redis:6379. Boot validation hard-errors on a
# localhost host when NODE_ENV=production.
REDIS_URL=redis://redis:6379            # REQUIRED (worker); warn-only for api, which still enqueues jobs


# ── AWS / S3 ─────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1                   # OPTIONAL — default: ap-south-1 (warns if unset in production)
# Static keys are OPTIONAL, and BOTH-OR-NEITHER. Leave both unset on ECS/EC2 and
# the AWS SDK uses the task/instance IAM ROLE — s3.service.ts passes '' precisely
# so that chain engages, so an unset pair is a supported deployment, not an
# error. It is a WARNING (the validator cannot tell "IAM role" from "forgot the
# keys" without calling STS; check with `aws sts get-caller-identity`).
# Setting exactly ONE of the two IS an error — half a pair authenticates nothing.
AWS_ACCESS_KEY_ID=AKIAEXAMPLE           # OPTIONAL (worker) — omit when using an instance/task IAM role
AWS_SECRET_ACCESS_KEY=change-me         # OPTIONAL (worker) — omit when using an instance/task IAM role
AWS_S3_BUCKET=hospital-app-images       # OPTIONAL — default: hospital-app-images (warns if unset in production)
# S3_BUCKET=                            # LEGACY alias for AWS_S3_BUCKET — set only one


# ── Anthropic / LLM ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-example        # REQUIRED (worker) — AI extraction; the SDK otherwise throws mid-pipeline
# CLAUDE_API_KEY=                       # LEGACY alias for ANTHROPIC_API_KEY — set only one
LLM_PROVIDER=claude                     # OPTIONAL — default: claude
LLM_MAX_CONCURRENT_HAIKU=8              # OPTIONAL — divide by the worker replica count before --scale worker=N
LLM_MAX_CONCURRENT_SONNET=4             # OPTIONAL — same
# LLM_REPLAY_MODE=                      # OPTIONAL — record|replay, for the eval harness
# LLM_REPLAY_DIR=                       # OPTIONAL
# LLM_REPLAY_STRICT=                    # OPTIONAL
# VOYAGE_API_KEY=                       # OPTIONAL — embeddings; episodic memory degrades without it
# VOYAGE_MODEL=                         # OPTIONAL


# ── Document extraction engine — THE VISION SPEND LEVERS ─────────────────────
#
# As of Sep 2026 the document engine is VISION-FIRST: a page with no usable
# typed text is read by Claude Vision (high-DPI overlapping tiles + deskew)
# rather than by Tesseract. That is a correctness decision, and it is the
# largest per-claim cost item in the system. Order-of-magnitude, from the code
# that spends it:
#
# MEASURED UNIT COSTS (certified 2026-09-14, Sonnet 4.5, USD→INR at 83). These
# are per CALL, not per page of paper, and they are what every cap below is
# sized against:
#
#   doc_extract.<category>, tiled, dense A4 portrait, itemised  ₹8.646
#                                             (n=3, 416/416 cells = 100.00%)
#   doc_extract.<category>, tiled, landscape bill, itemised     ₹5.003
#                                             (n=2, 196/196 cells = 100.00%)
#   ocr_vision_page, one page read                              ₹4.985/page
#   the same extractions BEFORE tiling         ₹7.42 portrait / ₹3.74 landscape
#   text input tokens   ~₹0.07/1k              vision tokens    ~₹2/1k
#
# Tiling is what bought the two 100.00% numbers, and it cost +17% (portrait)
# and +34% (landscape) per extraction to do it.
#
# EVERY VARIABLE IN THIS SECTION IS READ PER CALL, not at import time — so a
# change takes effect on the next extraction after
# `docker compose up -d --force-recreate`, with no rebuild and no code deploy.
# See docs/proposals/DEPLOYMENT_RUNBOOK.md § 8 for the incident procedure.

# ── THE PER-CLAIM SPEND CAPS ───────────────────────────────────────────────
#
# TWO SEPARATE DIMENSIONS, because they scale on different axes. Both are read
# per call in costAccounting.service.ts, both default to the value shown, and
# both take effect on the next call after a `--force-recreate` — no deploy.
#
# 1. REASONING (CLAIM_HARD_LIMIT_INR). Everything that is NOT a page read:
#    doc_segmenter, doc_bundle_classify, doc_classify, harmonisation, and —
#    this is the one that surprises people — doc_extract.<category>. A tiled
#    section read is reasoning, not OCR, so it charges HERE.
#
#    ── WHY IT IS ₹150 AND WAS ₹40 UNTIL 2026-09-14 ────────────────────────
#
#    This number moved because the PRICES became true, not because anyone
#    decided claims may cost more. It is a signed product decision, and the
#    arithmetic is three lines:
#
#      claudeClient.COST_TABLE was keyed on the model ALIAS
#      ('claude-sonnet-4-5'); the Anthropic API answers with the DATED id
#      ('claude-sonnet-4-5-20250929'); the exact-key lookup missed on every
#      real call and silently charged HAIKU rates. Sonnet is 3.75x Haiku on
#      input, output and cached input alike. Measured on one tiled dense-A4
#      itemised extraction: ₹2.21 RECORDED vs ₹8.30 TRUE.
#
#        old cap × mispricing factor  =  ₹40 × 3.75  =  ₹150
#
#    So ₹150 is the ceiling production has ALREADY been running under, stated
#    in honest rupees. Correcting the pricing without moving the cap would not
#    tighten a loose limit — it would convert a silent 3.75x overspend into a
#    loud dead-letter on ordinary claims. Five dense itemised sections plus
#    overhead is ₹46.2 true; that claim passes today (ledger reads ₹12.3) and
#    would block the instant pricing is right. Block -> LlmBudgetExceededError
#    -> 3 Bull retries -> dead letter, claim half-extracted.
#
#    What ₹150 buys at TRUE prices:
#
#      fixed per claim      doc_segmenter ~₹0.9 + doc_bundle_classify ~₹2.1  ₹3.0
#      17 × dense portrait itemised extraction   17 × ₹8.646             ₹147.0
#      (or 29 landscape ones at ₹5.003)                                  ₹148.1
#
#    THIS IS NOT THE REAL CEILING, AND THE GAP IS STRUCTURAL. checkBudget is a
#    PRE-FLIGHT: it reads accumulated spend and answers "may I make a call?"
#    before a call whose cost is unknown until it returns. A pre-flight cannot
#    bound the call it authorises. The honest statement is therefore
#
#      effective ceiling = CLAIM_HARD_LIMIT_INR + ONE MAXIMAL doc_extract CALL
#
#    and a maximal doc_extract is not small: up to 8 rendered pages
#    (MAX_VISION_PAGES in docExtractor.service.ts) at overview + ~3 tiles ≈
#    6,272 image tokens/page ≈ ₹1.56/page = ~₹12.5 of image input, plus up to
#    16,384 output tokens at $15/M ≈ ₹20.4. About ₹33. So this limit reads:
#
#      "₹150, and a claim may finish at ~₹183."
#
#    Use ₹183 for any worst-case spend planning. Closing that gap needs a
#    MID-CALL bound (the OCR pump has one; reasoning does not) or a smaller
#    maximal call — not a smaller cap.
#
#    TIGHTENING FROM ₹150 IS A SEPARATE, DATA-DRIVEN DECISION, and it cannot
#    honestly be made yet: until the pricing fix ships, no recorded reasoning
#    figure in the database is true, so there is nothing to tighten against.
#    Revisit after one release cycle of a correct ledger. CLAIM_SOFT_LIMIT_INR
#    is pinned at ₹60 (NOT 70% of the hard cap, which would be ₹105) precisely
#    to make that cycle observable: ₹60 is 1.5x the OLD nominal ₹40, so the
#    first claim past what we used to believe the ceiling was becomes a log
#    line immediately, with ₹90 still separating it from anything blocking.
#
#    DO NOT lower this below ~₹20 without also turning tiling down; the old
#    ₹15 reproduces the 2026-09 dead-letter (two itemised sections on one
#    claim are ₹17.29 true).
#
# 2. OCR PAGE TRANSCRIPTION (CLAIM_OCR_HARD_LIMIT_INR). Page reads only —
#    tasks ocr_vision_page / ocr_vision_image / ocr_vision_read /
#    ocr_vision_fallback. At ₹4.985/page, ₹300 buys one full 40-page scanned
#    bundle (~₹200) plus a second smaller document on the same claim. It is
#    bounded by how much paper the hospital uploaded, which is why it is its
#    own dimension: capping page reads at the reasoning number would not make
#    OCR cheaper, it would fail the claim. Exceeding it does NOT block — the
#    remaining pages become UNREADABLE PAGES carrying reason 'cost_budget',
#    surfaced to the user with an action, rather than silently degrading to
#    Tesseract (see getOcrReadAllowanceInr).
#
#    IT IS DELIBERATELY *NOT* RE-TUNED ALONGSIDE THE REASONING CAP. The Sonnet
#    mispricing never touched this dimension: visionRead.ts computes its cost
#    from its own hardcoded Sonnet rates and never calls computeCostInr, so the
#    OCR ledger was always correct and ₹300 still means ₹300.
#
# Lowering either is a legitimate incident response. Lowering the REASONING one
# stops claims; lowering the OCR one only leaves pages unread. Prefer the OCR one.
# CLAIM_HARD_LIMIT_INR=80               # OPTIONAL — per-claim REASONING cap, INR. Default: 80, sized just above the
#                                       # measured post-tiling p99 (~₹69) from 48 real claims. Was 15 before the
#                                       #            2026-09-14 pricing fix; 40 × 3.75 preserves live behaviour).
#                                       #            Blocks at the cap; effective ceiling ~₹183, see above.
# CLAIM_SOFT_LIMIT_INR=60               # OPTIONAL — warn-only threshold. Default: 60. PINNED, not 70% of the hard
#                                       #            cap — it is set to just past the old nominal ₹40 on purpose.
# CLAIM_OCR_HARD_LIMIT_INR=300          # OPTIONAL — per-claim PAGE-READ cap, INR. Default: 300. Marks pages
#                                       #            unreadable, never blocks. NOT re-tuned; it was never wrong.
# CLAIM_OCR_SOFT_LIMIT_INR=210          # OPTIONAL — warn-only. Default: 70% of CLAIM_OCR_HARD_LIMIT_INR (₹210).
# OCR_VISION_MAX_COST_INR_PER_READ=250  # OPTIONAL — ceiling on ONE extractTextFromPdf call. Default: 250. Stops a
#                                       #            single 500-page upload eating the whole claim's OCR budget.
# A non-numeric, zero or negative value in any of the five falls back to its
# default — a typo cannot silently disable a cap.

# ── PER-RUN COST CONSENT (the user's own budget) ───────────────────────────
#
# A DIFFERENT KIND OF LIMIT from the five above. Those are OPERATOR policy: no
# single claim or hospital may run away, and a user never sees them. This one is
# A NUMBER A HUMAN AGREED TO before pressing Run Analysis, and the contract we
# owe them is that we ASK AGAIN before spending past it — rather than silently
# exceeding it, or silently stopping short and presenting half a claim as whole.
#
# Crossing it therefore neither blocks nor throttles. checkBudget returns the
# verdict action 'pause_for_consent', the run parks at status='paused' with
# spend-so-far and a remaining estimate, and the user either approves more or
# ends the run cleanly with partial results. Consent buys headroom INSIDE the
# operator caps, never through them: a static-cap block still blocks.
#
# The pre-flight estimate is computed by a CPU-ONLY page census (pdf-parse, no
# provider call, ₹0). That is load-bearing — a quote that costs money to produce
# is a quote you cannot offer BEFORE consent.
#
# ALL OF THESE ARE READ PER CALL, never snapshotted at import, so a re-tune
# takes effect on the very next quote. That matters more here than elsewhere: if
# the price a user is shown and the price the pipeline enforces drift apart,
# consent becomes a number about nothing.
# ANALYZE_BUDGET_CONSENT_REQUIRED=true  # OPTIONAL — default: true. "false" auto-approves each run at the estimate's
#                                       #            recommended budget with budget_approved_by = NULL. CI relies on
#                                       #            it. NEVER SET IT FALSE IN PRODUCTION: it turns "the user agreed
#                                       #            to spend this" into "a config file agreed to spend this".
# AI_RUN_MIN_APPROVED_BUDGET_INR=5      # OPTIONAL — default: 5. Floor on what one run may be approved for.
# AI_RUN_MAX_APPROVED_BUDGET_INR=1000   # OPTIONAL — default: 1000. Ceiling. A request ABOVE it is an HTTP 400, not a
#                                       #            silent clamp — a clamp is how consent becomes theatre (the user
#                                       #            approves ₹5,000, we quietly approve ₹1,000, the run then pauses
#                                       #            for a reason they were never told about).
#
# The estimator's multipliers. Defaults are the measured 2026-09-14 figures
# rounded to quoting precision; change them only with a measurement in hand.
# EST_BUNDLE_CLASSIFY_INR_PER_DOC=2.1   # OPTIONAL — default: 2.1. Fixed per document: segment + bundle-classify.
# EST_SECTION_EXTRACT_INR=8.65          # OPTIONAL — default: 8.65. ONE heavy section (tiled dense-portrait itemised
#                                       #            bill — measured ₹8.646). Every document is quoted one of these,
#                                       #            because nearly every document that matters has one.
# EST_SECTION_EXTRACT_LIGHT_INR=1.5     # OPTIONAL — default: 1.5. Every OTHER section: discharge summaries, ID
#                                       #            proofs, consent forms — a few scalars, no line-item table.
# EST_PAGES_PER_SECTION=3               # OPTIONAL — default: 3. Turns a page count into a section count.
# EST_BUDGET_SAFETY_FACTOR=1.25         # OPTIONAL — default: 1.25, then rounded UP to the next ₹10. Deliberately
#                                       #            generous, and the asymmetry is the reason: quoting 20% high
#                                       #            costs nothing, while coming in 5% short costs a mid-run pause,
#                                       #            a human interruption, and an OCR RE-READ of the document that
#                                       #            was cut short (a paused read is discarded, never inherited).
# RUN_CONTROL_MEMO_MS=1000              # OPTIONAL — default: 1000. How long a worker may cache "is this run paused?"
#                                       #            Postgres is the sole authority on the pause; Redis pub/sub is
#                                       #            advisory wake-up only. One indexed PK read per second per worker
#                                       #            is free, and cheaper than the mistake of caching it longer.

# THE ONE-LINE REVERT. 'ocr' restores the pre-vision default AND (while
# OCR_ENGINE is unset) switches ocr.service back to Tesseract, so no per-page
# Anthropic call survives the switch. This is the flag to reach for first.
# It does NOT override a category pinned in the database — see the note at the
# end of this section.
# DOC_EXTRACT_DEFAULT_MODE=vision       # OPTIONAL — ocr|vision|auto. Default: vision

# The engine ocr.service uses when a page has no typed text. Unset means
# "inherit DOC_EXTRACT_DEFAULT_MODE", which is why the one-line revert works.
# Set it explicitly only to express a combination the inheritance cannot:
# e.g. DOC_EXTRACT_DEFAULT_MODE=ocr + OCR_ENGINE=vision.
# OCR_ENGINE=vision                     # OPTIONAL — vision|tesseract|auto. Default: vision (inherits the revert)

# HARD KILL-SWITCH. "true" blocks every vision call in ocr.service, outranking
# explicit caller intent (forceVisionAllPages included) — because the reason to
# flip it, a provider incident or a spend freeze, is exactly the reason a
# caller must not be able to punch through. Reads fall back to Tesseract.
# OCR_VISION_FALLBACK_DISABLED=         # OPTIONAL — literal "true" to kill vision. Default: unset = vision allowed

# Page budgets. Vision costs ONE PROVIDER CALL PER PAGE, so these are the
# ceilings that stop a single scanned bundle from spending hundreds of rupees.
# Pages past a budget fall back to Tesseract with a warning on the result —
# the document stays readable, it does not fail.
# OCR_VISION_MAX_PAGES=8                # OPTIONAL — ocr.service's section-scope budget. Default: 8 (~₹40 at ₹4.985/page)
#                                       #            It does NOT reach docExtractor's OWN vision path (the one a
#                                       #            category pinned to 'vision' takes, which never calls
#                                       #            ocr.service): that path caps attached pages at the hardcoded
#                                       #            MAX_VISION_PAGES = 8 in docExtractor.service.ts. Same number
#                                       #            today, but nothing keeps them in step and no env var moves the
#                                       #            second one. See the cap note above on multi-page sections.
# OCR_VISION_MAX_PAGES_UNATTENDED=3     # OPTIONAL — budget for a call with NO claim/hospital context, i.e. inbound
#                                       #            email attachments, where the SENDER picks the page count.
#                                       #            Default: 3. Never exceeds OCR_VISION_MAX_PAGES.
# OCR_VISION_MAX_PAGES_DOCUMENT=40      # OPTIONAL — ceiling on one document-scope read. Default: 40 (~₹150-240).
#                                       #            Clamped reads warn 'vision_document_budget_clamped'.
# OCR_VISION_CONCURRENCY=3              # OPTIONAL — parallel vision lanes per document. Default: 3, hard max 8.
#                                       #            Latency, not cost — but it IS per worker replica, so divide
#                                       #            by the replica count before `--scale worker=N`.
# OCR_VISION_EST_PAGE_COST_INR=5.5      # OPTIONAL — default: 5.5. What ONE vision page read is assumed to cost.
#                                       #            Read by BOTH ocr.service (which projects with it before
#                                       #            dispatching a page) and costAccounting.estimateRunCostInr
#                                       #            (which quotes with it). They MUST stay the same number: a
#                                       #            quote priced differently from the read promises a different
#                                       #            amount of work than the one that actually runs.

# Accuracy knobs. Both default ON; "0" disables with no deploy. Disabling
# TILING lowers spend on wide pages (one image instead of overview + tiles) and
# costs accuracy — a landscape bill measured 100.00% tiled vs 96.43% as a
# single image, because Anthropic silently re-scales any image over ~1.15MP.
# Treat EXTRACT_TILING_ENABLED=0 as a last-resort spend lever, not a tuning one.
# EXTRACT_TILING_ENABLED=               # OPTIONAL — "0" sends one fitted image per page. Default: unset = tiling ON
# EXTRACT_DESKEW_ENABLED=               # OPTIONAL — "0" skips small-angle deskew. Default: unset = deskew ON
# OCR_PREPROCESS_DISABLED=              # OPTIONAL — literal "true" skips the Tesseract-path image preprocessing

# ── KNOWN GAP: tiling is all-or-nothing. There is NO env var here. ──────────
#
# DO NOT SET ANYTHING FOR THIS. It is written down because the lever is missing,
# not because it exists. `minTileResolutionGain` — the floor a tiled plan must
# beat before tiling is worth 3-4× the images — is a hardcoded constant:
# `DEFAULT_MIN_TILE_RESOLUTION_GAIN = 1.1` in
# Backend/src/Services/extractor/imageTiler.ts (line 142 today; grep the name,
# that file is under active change). `planTiles()` does accept a per-call
# `opts.minTileResolutionGain` override, but no caller passes one and nothing
# reads an environment variable for it: the only `process.env` read in that
# whole module is EXTRACT_TILING_ENABLED.
#
# What that costs. A plain 150-dpi A4 scan (1240x1754) clears the 1.1 floor at a
# 1.36× resolution gain, so it emits 3 images instead of 1 — ~3× the per-page
# vision cost — on a page that a single fitted image usually reads fine. An
# operator who wants to stop paying for that on routine portrait scans while
# KEEPING tiling on the wide landscape bills (where it is worth 100.00% vs
# 96.43%) has no dial: their only lever is EXTRACT_TILING_ENABLED=0, which
# turns tiling off everywhere, landscape bills included.
#
# Wiring it would be a few lines in imageTiler.ts (read the env in the same
# place EXTRACT_TILING_ENABLED is read, default 1.1, floor at 1). It is not done
# here because this file must not advertise a knob the code does not read — a
# documented variable that silently does nothing is worse during an incident
# than an honestly documented gap. See DEPLOYMENT_RUNBOOK.md § 8.

# PipelineV2 page reader: which model tier reads a page FIRST. 'premium' is a
# deliberate cost increase; only the eval harness normally sets it.
# PIPELINEV2_PAGE_READ_FIRST_TIER=      # OPTIONAL — cheap|premium. Default: cheap

# NOT an env var, but the other half of this dial: hospital.master_options
# .extraction_mode ('ocr' | 'vision' | 'auto', NULL = use
# DOC_EXTRACT_DEFAULT_MODE) routes a single doc_category. A seeded database
# ships 106 of its 246 categories already pinned — 98 to 'vision' and 8 to
# 'auto' — and a pinned row IGNORES every env flag above, because that path
# never calls ocr.service at all (docExtractor builds and sends the images
# itself). DOC_EXTRACT_DEFAULT_MODE=ocr IS THEREFORE NOT A COMPLETE ROLLBACK:
# it covers only the 140 NULL categories. The only revert for the other 106 is
# `UPDATE hospital.master_options SET extraction_mode = 'ocr' …`, and three more
# ('aadhaar_back', 'ration_card', 'pmjay_letter') are forced to vision in code
# and need a deploy. A value you set in the database IS durable: neither
# `npm run seed` nor a migration replay overwrites it. DEPLOYMENT_RUNBOOK.md § 8
# has the copy-pasteable SQL and the full three-step procedure.

# Eval-harness only (never set in a deployed environment):
# HARNESS_CORPUS_DIR= / HARNESS_GROUND_TRUTH= / HARNESS_MAX_INR= /
# HARNESS_UPDATE_BASELINE= / EXTRACT_HARNESS_TRIALS=


# ── JWT / auth ───────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=change-me-to-at-least-32-characters-long   # REQUIRED (api, worker) — min 32 chars; short secrets defeat jwt.verify
ACCESS_TOKEN_EXPIRY=15m                 # REQUIRED (api, worker)
REFRESH_TOKEN_EXPIRY_DAYS=30            # REQUIRED (api, worker) — integer


# ── Gmail / Google ───────────────────────────────────────────────────────────
# ENC_KEY encrypts the stored Gmail OAuth tokens. crypto.util.ts only throws at
# the FIRST decrypt, so an unset key looks fine at boot and breaks a poll hours
# later. In production it is therefore a hard error ONCE GMAIL IS ACTUALLY
# WIRED UP — GOOGLE_OAUTH_CLIENT_ID + GOOGLE_OAUTH_CLIENT_SECRET set and
# GMAIL_POLL_ENABLED not "false". With Gmail off it is only a warning, because
# nothing decrypts and refusing to boot would be a self-inflicted outage.
# A MALFORMED key is always an error: absent can work, wrong cannot.
ENC_KEY=<openssl rand -base64 32>       # REQUIRED in production once Gmail is configured — must decode to exactly 32 bytes
# ENC_KEY_PREVIOUS=                     # OPTIONAL — set during key rotation; validated the same way
GOOGLE_OAUTH_CLIENT_ID=                 # REQUIRED for Gmail features
GOOGLE_OAUTH_CLIENT_SECRET=             # REQUIRED for Gmail features
GOOGLE_OAUTH_REDIRECT_URI=              # REQUIRED for Gmail features
GMAIL_POLL_ENABLED=false                # OPTIONAL — UNSET MEANS ENABLED. Only the literal "false" stops the cron (gmailPoll.queue.ts:132)
GMAIL_POLL_INTERVAL_SECONDS=300         # OPTIONAL
# GOOGLE_SHEET_WEBHOOK_URL=             # OPTIONAL — sheet sync
# GOOGLE_SHEET_SECRET_TOKEN=            # OPTIONAL — sheet sync
# GOOGLE_DRIVE_ROOT_ID=                 # OPTIONAL — legacy Drive integration (removed May 2026)
# PARENT=                               # OPTIONAL — legacy Drive integration


# ── Feature flags / tuning (all OPTIONAL) ────────────────────────────────────
AI_ANALYSIS_ENABLED=false               # OPTIONAL — default: false
# AI_ANALYSIS_ALLOWED_CLAIMS=           # OPTIONAL — comma-separated allowlist
INTELLIGENCE_ENRICHMENT=off             # OPTIONAL
EPISODIC_RETRIEVAL_MODE=off             # OPTIONAL
# IDENTITY_GATE_ENABLED=                # OPTIONAL
# PIPELINEV2_PAGE_READ_FIRST_TIER, OCR_VISION_FALLBACK_DISABLED and
# OCR_PREPROCESS_DISABLED are documented under "Document extraction engine"
