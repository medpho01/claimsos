# CI fixture for .github/workflows/db-and-env.yml.
#
# Complete, well-formed, and ENTIRELY DUMMY — nothing here authenticates against
# anything. Safe to commit; explicitly un-ignored in .gitignore.
#
# Purpose: prove the validator ACCEPTS a complete production-shaped config. The
# workflow then removes REDIS_URL from a copy of this file to prove it REJECTS
# an incomplete one. Asserting the failure path is the point — a validator
# nobody tests silently degrades into a no-op.
#
# NODE_ENV=production on purpose: it exercises the strictest branch (ENC_KEY
# required, localhost Redis rejected, METRICS_TOKEN warned).

NODE_ENV=production
PORT=8000
RUN_WORKERS=true
CORS_ORIGIN=http://localhost:5001
APP_BASE_URL=http://localhost:5001
METRICS_TOKEN=ci-dummy-metrics-token
LOG_LEVEL=info
APP_VERSION=ci

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=claimsos
POSTGRES_PASSWORD=claimsos
POSTGRES_DB=claimsos
POSTGRES_SSLMODE=
DB_SSL=false

REDIS_URL=redis://redis:6379

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMIK7MDENGbPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=claimsos-ci-bucket

ANTHROPIC_API_KEY=sk-ant-ci-dummy-key-not-a-real-credential

# Document extraction engine — the vision spend levers, set to their CODE
# DEFAULTS. Nothing in CI extracts a document, so these change no behaviour
# here; they are present so a production-shaped config exercises the validator
# with them set, and so an operator copying this file as a starting point sees
# the dial rather than having to find it in ocr.service.ts mid-incident. Full
# annotation is in .env.example; the incident procedure is in
# docs/proposals/DEPLOYMENT_RUNBOOK.md § 8.
DOC_EXTRACT_DEFAULT_MODE=vision
OCR_VISION_MAX_PAGES=8
OCR_VISION_MAX_PAGES_UNATTENDED=3
OCR_VISION_MAX_PAGES_DOCUMENT=40
OCR_VISION_CONCURRENCY=3
OCR_VISION_EST_PAGE_COST_INR=5.5

# The two per-claim rupee caps, also at their code defaults. Measured per-call
# costs they are sized against (certified 2026-09-14, Sonnet 4.5, USD→INR 83).
# These are TRUE costs — until the claudeClient normalizeModelId fix the LEDGER
# recorded 1/3.75 of each, because COST_TABLE was keyed on the model alias and
# the API answers with the dated id, so every Sonnet call priced as Haiku:
#
#   doc_extract.<category> tiled, dense A4 portrait, itemised   ₹8.646
#   doc_extract.<category> tiled, landscape bill, itemised      ₹5.003
#   ocr_vision_page, one page read                              ₹4.985/page
#
# CLAIM_HARD_LIMIT_INR is the REASONING dimension and doc_extract.* counts
# against it. It is 150 and not the 40 it was until 2026-09-14: 40 × 3.75 is
# the exact mispricing factor, so 150 PRESERVES the ceiling production was
# already running under rather than setting new policy. Correcting the pricing
# without moving it would turn a silent overspend into a dead-letter on
# ordinary claims. Note the effective ceiling is ~₹183 — a pre-flight cannot
# bound the call it authorises, so a claim may finish one maximal doc_extract
# call (~₹33) above the cap. CLAIM_SOFT_LIMIT_INR is PINNED at 50 (not 70% of
# the hard cap) so the first claim past the old nominal ₹40 is loud in the logs.
# CLAIM_OCR_HARD_LIMIT_INR is the page-read dimension and is deliberately NOT
# re-tuned — visionRead prices itself correctly and its ledger was never wrong;
# exceeding it marks pages unreadable rather than blocking. Full annotation in
# .env.example, unit economics in docs/proposals/DEPLOYMENT_RUNBOOK.md § 8.
CLAIM_HARD_LIMIT_INR=80
CLAIM_SOFT_LIMIT_INR=50
CLAIM_OCR_HARD_LIMIT_INR=300
CLAIM_OCR_SOFT_LIMIT_INR=210
OCR_VISION_MAX_COST_INR_PER_READ=250

# Per-run cost consent. CI must never sit waiting for a human to approve a
# budget, so consent is DISABLED here and only here: the server auto-approves
# each run at the estimate's recommended figure and records
# budget_approved_by = NULL. In production this stays unset (default true) —
# 'false' turns "the user agreed to spend this" into "a config file agreed to
# spend this". The estimator multipliers below are at their code defaults so a
# production-shaped config exercises the validator with them set.
ANALYZE_BUDGET_CONSENT_REQUIRED=false
AI_RUN_MIN_APPROVED_BUDGET_INR=5
AI_RUN_MAX_APPROVED_BUDGET_INR=1000
EST_BUNDLE_CLASSIFY_INR_PER_DOC=2.1
EST_SECTION_EXTRACT_INR=8.65
EST_SECTION_EXTRACT_LIGHT_INR=1.5
EST_PAGES_PER_SECTION=3
EST_BUDGET_SAFETY_FACTOR=1.25
RUN_CONTROL_MEMO_MS=1000

ACCESS_TOKEN_SECRET=ci-dummy-access-token-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30

# 32 zero bytes, base64. Decodes to exactly 32 bytes, so it passes the ENC_KEY
# format check while being obviously worthless as a key.
ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
GOOGLE_OAUTH_CLIENT_ID=ci-dummy-client-id
GOOGLE_OAUTH_CLIENT_SECRET=ci-dummy-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback
GMAIL_POLL_ENABLED=false
